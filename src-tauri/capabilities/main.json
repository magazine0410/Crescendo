{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "The main window: every application command except the three the About window owns, plus the file pickers and 'reveal in file manager'.",
  "windows": [
    "main"
  ],
  "permissions": [
    "dialog:default",
    "opener:allow-reveal-item-in-dir",
    "allow-scan-start",
    "allow-scan-cancel",
    "allow-tag-edit-open",
    "allow-library-stats",
    "allow-browse-values",
    "allow-browse-albums",
    "allow-album-tracks",
    "allow-track-count",
    "allow-tracks-range",
    "allow-track-groups",
    "allow-track-index",
    "allow-album-by-id",
    "allow-search-highlight",
    "allow-plugin-file-drag-start",
    "allow-player-play-context",
    "allow-player-jump-to",
    "allow-player-toggle-pause",
    "allow-player-stop",
    "allow-player-next",
    "allow-player-prev",
    "allow-player-seek",
    "allow-player-set-volume",
    "allow-player-set-muted",
    "allow-player-set-shuffle",
    "allow-player-cycle-repeat",
    "allow-player-set-stop-after-current",
    "allow-player-set-spectrum-enabled",
    "allow-player-set-projectm-enabled",
    "allow-player-take-projectm-pcm",
    "allow-projectm-choose-folder",
    "allow-projectm-restore-folder",
    "allow-projectm-load-preset",
    "allow-projectm-load-asset",
    "allow-player-get-state",
    "allow-queue-add",
    "allow-queue-add-context",
    "allow-queue-remove",
    "allow-queue-clear",
    "allow-queue-list",
    "allow-playlist-list",
    "allow-playlist-create",
    "allow-playlist-rename",
    "allow-playlist-delete",
    "allow-playlists-set-order",
    "allow-playlist-tracks",
    "allow-playlist-tracks-multi",
    "allow-track-playlist-ids",
    "allow-playlist-add-tracks",
    "allow-playlist-remove-tracks",
    "allow-playlist-reorder",
    "allow-playlist-add-paths",
    "allow-playlist-import-m3u",
    "allow-collection-list",
    "allow-collection-set",
    "allow-collection-rename",
    "allow-collection-delete",
    "allow-collection-set-collapsed",
    "allow-plugin-list",
    "allow-plugin-choose-install",
    "allow-plugin-set-enabled",
    "allow-plugin-set-setting",
    "allow-plugin-uninstall",
    "allow-plugin-grouping-migration",
    "allow-plugin-restart-app",
    "allow-plugin-approve-grants",
    "allow-plugin-invoke",
    "allow-prefs-get-all",
    "allow-prefs-set",
    "allow-waveform-get",
    "allow-lastfm-artist-info",
    "allow-lastfm-album-info",
    "allow-lastfm-test-key",
    "allow-lastfm-status",
    "allow-lastfm-connect",
    "allow-lastfm-finish-connect",
    "allow-lastfm-set-enabled",
    "allow-lastfm-disconnect",
    "allow-song-history",
    "allow-lastfm-track-url",
    "allow-lastfm-open-track",
    "allow-lyrics-for-track",
    "allow-autostart-get",
    "allow-autostart-set",
    "allow-open-cover-window",
    "allow-open-about-window"
