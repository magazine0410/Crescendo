{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crescendo.local/schemas/plugin-manifest-v1.json",
  "title": "Crescendo plugin manifest v1",
  "description": "Editor-facing schema for Crescendo plugin manifests. The crescendo-plugin validator also enforces semantic references, compatibility versions, package limits, and kind-specific file rules.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "name",
    "version",
    "description",
    "authors",
    "license",
    "kind",
    "api_version",
    "min_crescendo_version"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "id": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9-]{0,62}(\\.[a-z][a-z0-9-]{0,62}){2,}$"
    },
    "name": { "$ref": "#/$defs/nonEmptyText" },
    "version": { "$ref": "#/$defs/semver" },
    "description": { "$ref": "#/$defs/text" },
    "authors": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/nonEmptyText" }
    },
    "license": { "$ref": "#/$defs/nonEmptyText" },
    "homepage": {
      "type": "string",
      "maxLength": 4096,
      "pattern": "^https?://"
    },
    "kind": { "enum": ["declarative", "wasm"] },
    "api_version": { "$ref": "#/$defs/semver" },
    "min_crescendo_version": { "$ref": "#/$defs/semver" },
    "permissions": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "enum": [
          "library.read",
          "library.paths",
          "player.read",
          "player.control",
          "playlists.read",
          "playlists.write",
          "network.http",
          "storage"
        ]
      }
    },
    "network_domains": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 253,
        "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$"
      }
    },
    "contributes": { "$ref": "#/$defs/contributions" }
  },
  "$defs": {
    "text": { "type": "string", "maxLength": 4096 },
    "nonEmptyText": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "targetTag": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "booleanSetting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "key", "label", "default"],
      "properties": {
        "type": { "const": "boolean" },
        "key": { "$ref": "#/$defs/key" },
        "label": { "$ref": "#/$defs/nonEmptyText" },
        "description": { "$ref": "#/$defs/text" },
        "default": { "type": "boolean" }
      }
    },
    "stringSetting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "key", "label", "default"],
      "properties": {
        "type": { "const": "string" },
        "key": { "$ref": "#/$defs/key" },
        "label": { "$ref": "#/$defs/nonEmptyText" },
        "description": { "$ref": "#/$defs/text" },
        "default": { "type": "string", "maxLength": 4096 },
        "min_length": { "type": "integer", "minimum": 0, "maximum": 4096 },
        "max_length": { "type": "integer", "minimum": 0, "maximum": 4096 }
      }
    },
    "numberSetting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "key", "label", "default"],
      "properties": {
        "type": { "const": "number" },
        "key": { "$ref": "#/$defs/key" },
        "label": { "$ref": "#/$defs/nonEmptyText" },
        "description": { "$ref": "#/$defs/text" },
        "default": { "type": "number" },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "step": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "selectOption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "label"],
      "properties": {
        "value": { "$ref": "#/$defs/nonEmptyText" },
        "label": { "$ref": "#/$defs/nonEmptyText" }
      }
    },
    "selectSetting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "key", "label", "default", "options"],
      "properties": {
        "type": { "const": "select" },
        "key": { "$ref": "#/$defs/key" },
        "label": { "$ref": "#/$defs/nonEmptyText" },
        "description": { "$ref": "#/$defs/text" },
        "default": { "type": "string", "maxLength": 4096 },
        "options": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": { "$ref": "#/$defs/selectOption" }
        }
      }
    },
    "setting": {
      "oneOf": [
        { "$ref": "#/$defs/booleanSetting" },
        { "$ref": "#/$defs/stringSetting" },
        { "$ref": "#/$defs/numberSetting" },
        { "$ref": "#/$defs/selectSetting" }
      ]
    },
    "facetTransform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "target_tag", "delimiter", "trim_whitespace", "enabled_setting"],
      "properties": {
        "type": { "const": "text.first_segment" },
        "target_tag": { "$ref": "#/$defs/targetTag" },
        "delimiter": { "type": "string", "minLength": 1, "maxLength": 32 },
        "trim_whitespace": { "type": "boolean" },
        "enabled_setting": { "$ref": "#/$defs/key" }
      }
    },
    "menuVisibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["active_tag"],
      "properties": { "active_tag": { "$ref": "#/$defs/targetTag" } }
    },
    "menuAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "setting"],
      "properties": {
        "type": { "const": "toggle_setting" },
        "setting": { "$ref": "#/$defs/key" }
      }
    },
    "menuControl": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "slot", "label", "visible_when", "checked_setting", "action"],
      "properties": {
        "id": { "$ref": "#/$defs/key" },
        "slot": { "const": "library.filter" },
        "label": { "$ref": "#/$defs/nonEmptyText" },
        "visible_when": { "$ref": "#/$defs/menuVisibility" },
        "checked_setting": { "$ref": "#/$defs/key" },
        "action": { "$ref": "#/$defs/menuAction" }
      }
    },
    "commandDeclaration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": { "id": { "$ref": "#/$defs/key" } }
    },
    "contributions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "settings": {
          "type": "array",
          "maxItems": 128,
          "items": { "$ref": "#/$defs/setting" }
        },
        "facet_transforms": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "#/$defs/facetTransform" }
        },
        "menu_controls": {
          "type": "array",
          "maxItems": 64,
          "items": { "$ref": "#/$defs/menuControl" }
        },
        "commands": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "#/$defs/commandDeclaration" }
        }
      }
    }
  }
}
